## Renomear este arquivo para `.env` e configurar as variáveis de ambiente conforme necessário.

# Configurações de Banco de Dados
DB_NAME=vidaplena
DB_USER=vidaplena
DB_PASSWORD=vidaplena_secure_password_2026

# Configurações de Segurança
JWT_SECRET=vidaplena-super-secret-production-key-for-jwt-signing-2026
JWT_EXPIRATION=PT2H

# Habilitação do Swagger 
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
